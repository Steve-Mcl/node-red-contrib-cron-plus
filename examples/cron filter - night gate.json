[{"id":"cfng.comment","type":"comment","z":"cfng.flow","name":"Cron Filter demo: gate schedule events on plain-English conditions","info":"The cronplus node fires every 30 seconds. Each Cron Filter node then allows or blocks the event based on a free-text condition. Open a filter node and watch the understanding line while you edit the condition. Sun/moon conditions need a location - here it is set on the filter nodes, but it can also arrive on the message (msg.location or a cronplus solar/lunar schedule's msg.cronplus.config.location).","x":330,"y":80,"wires":[]},{"id":"cfng.cron","type":"cronplus","z":"cfng.flow","name":"every 30s","outputField":"payload","timeZone":"","persistDynamic":false,"commandResponseMsgOutput":"output1","outputs":1,"options":[{"name":"tick","topic":"tick","payloadType":"default","payload":"","expressionType":"cron","expression":"*/30 * * * * * *","location":"","offset":"0","solarType":"all","solarEvents":"sunrise,sunset"}],"x":140,"y":160,"wires":[["cfng.night","cfng.hours","cfng.moon"]]},{"id":"cfng.night","type":"cronplus-filter","z":"cfng.flow","name":"","condition":"is night","location":"51.501364 -0.141890","locationType":"fixed","timeZone":"","x":360,"y":140,"wires":[["cfng.night.pass"],["cfng.night.block"]]},{"id":"cfng.hours","type":"cronplus-filter","z":"cfng.flow","name":"","condition":"weekdays between 9am and 5pm","location":"","locationType":"none","timeZone":"","x":420,"y":220,"wires":[["cfng.hours.pass"],["cfng.hours.block"]]},{"id":"cfng.moon","type":"cronplus-filter","z":"cfng.flow","name":"","condition":"when the moon is visible","location":"51.501364 -0.141890","locationType":"fixed","timeZone":"","x":400,"y":300,"wires":[["cfng.moon.pass"],["cfng.moon.block"]]},{"id":"cfng.night.pass","type":"debug","z":"cfng.flow","name":"night: allowed","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"filter","targetType":"msg","statusVal":"","statusType":"auto","x":660,"y":120,"wires":[]},{"id":"cfng.night.